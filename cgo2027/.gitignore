# Run outputs, build products, machine-local pins and compile caches never
# enter the repository. What a run reads and the artifact ships is tracked:
# cost_models/cm_sm_120_RTX5090.* and cost_models/x1e6/ (the RTX 5090 cost model
# and its Herbie platforms), benchmarks/*/profiles/ (the profiles the expected
# decisions were made from), benchmarks/genga_nbody/herbie_answers/ (Herbie's
# answers, replayed by default), expected/ (the expected decisions) and
# devices/ (the B300 and GH200 models and Herbie answers, and every device's
# shipped solve caches).
local.env
/cost_models/target.env
/cost_models/measured/
/cost_models/bootstrap_timing.txt
/cost_models/tcec_backend_ab.tsv
/cost_models/.build/
.detected.mk*
/picks_check/
/explain/
/benchmarks/*/cache*/
/benchmarks/*/measured/
/logs/
/results/
/results_*.tar.gz
/b300_handoff.tar.gz
/poseidon-artifact-*.out
/figures/*.pdf
/benchmarks/ozp/data/
/benchmarks/*/traces/
/benchmarks/*/*.tsv
/third_party/*/build/
/third_party/*/build_*.log
logs*/
reports*/
tmp*/
table.json
budgets.txt
overhead.tsv
*.log
*.out
drift.csv
fpprofile*
__pycache__/
.snapshot_*
*.bak
*.pre-*
tcec_rt_check
tcec_rt_check_own
tcec_calibrate
cumpsgemm_tcec_ref
*.exe
*.o
*.so
*.a
# The repository root .gitignore has `build*/`; these are sources, not build trees.
!/scripts/build_cumpsgemm.sh
!build_*.sh
# Write-once dispatch descriptors and stray run outputs (added 2026-09-05).
*.ozdispatch
*.gap-*
*.bak.*
# The shipped DP tables (scripts/make_caches.sh).
!/devices/*/caches/**/table.json
# The RTX 5090 run EXPECTED_RESULTS.md cites lives whole under
# benchmarks/<bench>/golden/rtx5090/, logs and drift file included.
!/benchmarks/*/golden/**/*.log
!/benchmarks/*/golden/**/drift.csv
# Per-benchmark run guards and the compiler's per-site profile-generation records.
.run.lock
.run.pid
.poseidon/

deps/
